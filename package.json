{
  "name": "clawd",
  "version": "1.0.2",
  "description": "Claude Code CLI Wrapper for multi-phase project execution",
  "main": "src/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HMilbradt/clawd.git"
  },
  "bugs": {
    "url": "https://github.com/HMilbradt/clawd/issues"
  },
  "homepage": "https://github.com/HMilbradt/clawd#readme",
  "bin": {
    "clawd": "./bin/clawd.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "prepare": "husky"
  },
  "keywords": [
    "claude",
    "cli",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.9.0",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "blessed": "^0.1.81",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mustache": "^4.2.0",
    "pino": "^10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "husky": "^9.1.7",
    "semantic-release": "^24.2.9",
    "vitest": "^4.0.3"
  }
}
